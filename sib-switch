#!/usr/bin/env bash
. lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [-f] [-h] <chain-ish>

Move HEAD to <chain-ish>.

By default, HEAD is detached at the resolved chain. With -f,
<chain-ish> must be a ref and HEAD follows that ref.
EOF
}

symbolic=

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h)  usage; exit 0 ;;
        -f)  symbolic=true; shift ;;
        --)  shift; break ;;
        -*)  echo "unknown option: $1" >&2; usage; exit 1 ;;
        *)   break ;;
    esac
done

[[ $# -eq 1 ]] || { usage >&2; exit 1; }
chain="$1"

is_ref() {
    sib show-ref "$1" >/dev/null 2>&1
}

if [[ -n $symbolic ]]; then
    is_ref "$chain" || die "-f set but $chain is not ref"
    sib symbolic-ref -m "switch to symbolic $chain" HEAD "$chain"
else
    res=$(sib rev-parse "$chain" 2>/dev/null) || die "$chain is invalid"
    sib update-ref -m "switch to $chain" --no-deref HEAD $res
fi
