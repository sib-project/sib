#!/usr/bin/env bash
set -euo pipefail

: "${SIB_DIR:?SIB_DIR is not set}"

TRACE_MAGIC=_SIBTRACE
TRACE_VERSION=v1

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

lgit() {
    env GIT_AUTHOR_DATE='@0 +0000' \
        GIT_COMMITTER_DATE='@0 +0000' \
        GIT_AUTHOR_NAME='Sibylline' \
        GIT_COMMITTER_NAME='Sibylline' \
        GIT_AUTHOR_EMAIL='sib@local' \
        GIT_COMMITTER_EMAIL='sib@local' \
        git --git-dir="$SIB_DIR" "$@"
}

cmd_init() {
    if [[ -e "$SIB_DIR" ]]; then
        printf 'sib: %s already exists\n' "$SIB_DIR" >&2
        exit 1
    fi
    mkdir -p "$SIB_DIR"
    lgit init --bare --quiet
}

# hash and format blob (to mktree format)
# $1: blob name
hf_blob() {
    [ -n "$1" ] || return 1;
    printf '100644 blob %s\t%s\n' $(lgit hash-object -w --stdin) "$1"
}

# chain-trace [-p <chain>] <trace>
cmd_chain_trace() {
    local parent=
    local trace=

    if [[ $# -eq 1 ]]; then
        trace="$1"
    elif [[ $# -eq 3 && "$1" == "-p" ]]; then
        cmd_ls_trace $2 >/dev/null # check if parent is valid
        parent="-p $2"
        trace="$3"
    else
        die "Usage: chain-trace [-p <chain>] <trace>"
    fi

    cmd_ls_trace $trace >/dev/null # check if itself is valid
    lgit commit-tree $parent $trace </dev/null
}

tf_key() {
    cut -d' ' -f1
}

tf_is_dup() {
    tf_key | sort | uniq -d | grep -q .
}

cmd_mktrace() {
    local lines=$(cat)

    echo "$lines" | tf_is_dup && die 'duplicate key found in input'

    {
        echo -n $TRACE_VERSION | hf_blob $TRACE_MAGIC;
        [ -n "$lines" ] && echo "$lines" | while read key hash; do
                printf "100644 blob %s\t%s\n" "$hash" "$key"
            done
    } | lgit mktree
}

cmd_ls_trace() {
    [ -n "$1" ] || die 'usage: ls-trace <trace>'

    local tmp=$(lgit ls-tree $1 | awk 'NF==4 { print $4, $3 }')

    echo "$tmp" | tf_key | grep -qxF $TRACE_MAGIC || die 'magic not found on trace'
    echo "$tmp" | tf_is_dup && die 'duplicate key found on trace'

    # Here, every key starting with $TRACE_MAGIC will be considered as
    # non-key and internal indicator.
    echo "$tmp" | grep -v "^$TRACE_MAGIC" || true # return 0 for empty trace
}

cmd_git() {
    lgit "$@"
}


# hash and format blob (to trace format)
# $1: blob name
tf_blob() {
    hf_blob "$1" | awk '{ print $4, $3 }'
}

# json -> ls_trace format
# Input: {"key": "value", "key": "value", ...}
# Hash every values
tf_json() {
    local json
    json="$(cat)"

    # Reject null/array/object/non-object
    [ "$(echo "$json" | jq -r 'type')" = "object" ] \
        || die 'input must be a JSON object'

    echo "$json" | jq -r 'keys_unsorted[]' | while IFS= read -r key; do
        case "$key" in
            "$TRACE_MAGIC"*) die "reserved key prefix: $key" ;;
            '') die 'empty key' ;;
        esac

        # Extract value to raw.
        echo "$json" | jq -j --arg k "$key" '.[$k]' | tf_blob "$key"
    done
}

cmd_mktrace_json() {
    tf_json | cmd_mktrace
}

# print single trace object to one-line json (jsonl)
cmd_ls_trace_json() {
    [ -n "$1" ] || die 'usage: ls-trace-json <trace>'
    local entries
    entries=$(cmd_ls_trace "$1") || exit 1
    [ -n "$entries" ] || { echo '{}'; return 0; }
    echo "$entries" | while read -r key hash; do
        lgit cat-file blob "$hash" \
            | jq -Rsc --arg k "$key" '{($k): .}'
    done | jq -cs 'add // {}'
}

cmd_chain_trace_json() {
    cmd_chain_trace "$@" "$(cmd_mktrace_json)"
}

cmd_ls_chain() {
    [ -n "$1" ] || die 'usage: ls-chain <chain-ish>'
    lgit cat-file commit "$1" | awk '
        /^$/ { exit }                          # stop at blank line (msg starts)
        $1 == "tree"   { print "trace " $2 }
        $1 == "parent" { print "parent " $2 }
    '
}

tf_value() {
    cut -d' ' -f2
}

trace_of_chain() {
    cmd_ls_chain "$1" | grep '^trace ' | tf_value
}

cmd_rev_list() {
    lgit rev-list "$@" | tac
}

cmd_rev_jsonl() {
    [ -n "$1" ] || die 'usage: rev-jsonl <chain-ish>'
    local commits
    commits=$(cmd_rev_list "$1") || die "rev-list failed for $1"
    while read -r commit; do
        local trace
        trace=$(trace_of_chain "$commit") || die "no trace for $commit"
        cmd_ls_trace_json "$trace"
    done <<< "$commits"
}

cmd_rev_parse() {
    [ $# -eq 1 ] || die 'usage: rev-parse <chain-ish>'
    lgit rev-parse --verify "$1^{commit}"
}

#
# Refs
#

cmd_update_ref() {
    lgit update-ref "$@"
}

cmd_show_ref() {
    [ $# -eq 1 ] || die 'usage: show-ref <ref>'
    lgit show-ref --verify --hash "$1"
}

cmd_list_refs() {
    local prefix=${1:-refs/}
    lgit for-each-ref --format='%(refname) %(objectname)' "$prefix"
}

cmd_symbolic_ref() {
    [ $# -eq 1 ] || die 'usage: symbolic-ref <name> <ref>'
    lgit symbolic-ref "$@"
}

main() {
    [[ $# -lt 1 ]] && { echo "usage: $0 <cmd> [args]" >&2; exit 1; }
    local cmd="$1"; shift
    local fn="cmd_${cmd//-/_}"
    if declare -F "$fn" > /dev/null; then
        "$fn" "$@"
    else
        printf '%s: unknown command %q\n' "$0" "$cmd" >&2
        exit 1
    fi
}
main "$@"
