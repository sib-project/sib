#!/usr/bin/env bash

. lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [-n] [-r] [-c] [--no-auth] [--no-stream] [-p <chain-ish>] [-s <name>] [-e ENDPOINT] [-m MODEL]
  -e, --endpoint     API endpoint (default \$PLM_ENDPOINT)
  -m, --model        Model name   (default \$PLM_MODEL)
  -p, --parent       Parent chain-ish to chain on (default HEAD)
  -s, --save         Save the current HEAD as <name> before asking
  -n, --new          Start new converastion
  -r, --resend       Do not accept or chain input (use with -p)
  -c, --only-chain   Chain user turn only, no API call done
      --no-stream    Disable streaming (PLM_USE_STREAM=false)
      --no-auth      Do not require API key (PLM_API_KEY_REQUIRED=0)
  -h, --help         Show this help
EOF
}

main() {
    local parent=HEAD parent_arg= resend= ref= only_chain=

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)        usage; exit 0 ;;
            -e|--endpoint)    export PLM_ENDPOINT="${2:?$1 requires arg}"; shift 2 ;;
            -m|--model)       export PLM_MODEL="${2:?$1 requires arg}"; shift 2 ;;
            -p|--parent)      parent="${2:?$1 requires arg}"; shift 2 ;;
            -s|--save)        ref="${2:?$1 requires arg}"; shift 2 ;;
            -n|--new)         parent=; shift ;;
            -r|--resend)      resend=1; shift ;;
            -c|--only-chain)  only_chain=1; shift ;;
            --no-stream)      export PLM_USE_STREAM='false'; shift ;;
            --no-auth)        export PLM_API_KEY_REQUIRED=0; shift ;;
            -*|*)             echo "unknown arg: $1" >&2; usage; exit 1 ;;
        esac
    done

    [[ -n $resend && -z $parent ]] && die "--new --resend doesn't make sense"

    [[ -n $ref ]] && sib save -- "$ref"

    local unborn=refs/sib/unborn

    # --new should not taint existing save (or other refs)
    [[ -z $parent ]] && sib symbolic-ref HEAD $unborn

    # --new sets parent= to make chain-trace-json create a new root
    # chain. If no arguments are passed to rev-parse, nothing is
    # printed. Therefore, $parent become empty here as well.
    parent="$(sib rev-parse $parent 2>/dev/null || true)"

    # rev-parse prints empty means there is no ref pointed to by
    # $parent. In this case, start a new chain and update HEAD.
    parent_arg="${parent:+-p $parent}"

    {
        if [[ -z $resend ]]; then
            [[ -t 0 ]] && echo '(stdin, Ctrl+D to send)' >&2

            plm-wrap -f text -t plm | sib chain-trace-json $parent_arg
        elif [[ -n $parent ]]; then
            echo $parent
        fi
    } | xargs -r sib update-ref -m 'ask: chain user turn' HEAD

    # A fresh store or --new initially uses an internal symbolic ref.
    # Once the first turn exists, replace it with a direct HEAD and remove
    # the bootstrap ref.
    if [[ $(sib symbolic-ref -q HEAD 2>/dev/null || true) == "$unborn" ]]; then
        sib switch HEAD
        sib update-ref --no-deref -d "$unborn"
    fi

    [[ -n $only_chain ]] && exit 0

    [[ -n $only_chain ]] && exit 0

    sib rev-jsonl HEAD \
        | plm-wrap -f plm -t request \
        | plm-send \
        | plm-wrap -f response -t plm -r assistant \
        | sib chain-trace-json -p HEAD \
        | xargs sib update-ref -m 'ask: chain agent turn' HEAD
}

# Human-readable message will be streamed to fd 3 by plm-send. Bind
# fd 3 to this script's stdout so users can pipe the message.
main "$@" 3>&1
