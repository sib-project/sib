#!/usr/bin/env bash
set -euo pipefail

source lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [--no-auth] [--no-stream] [-p <chain-ish>] [-e ENDPOINT] [-m MODEL]
  -e, --endpoint     API endpoint (default \$PLM_ENDPOINT)
  -m, --model        Model name   (default \$PLM_MODEL)
  -p, --parent       Parent chain-ish to chain on (default HEAD)
  -r, --resend       Do not accept input
      --no-stream    Disable streaming (PLM_USE_STREAM=false)
      --no-auth      Do not require API key (PLM_API_KEY_REQUIRED=0)
  -h, --help         Show this help
EOF
}

need_arg() { [[ $# -ge 2 ]] || { echo "error: $1 requires an argument" >&2; exit 2; }; }

main() {
    local parent=HEAD resend=

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)        usage; exit 0 ;;
            -e|--endpoint)    need_arg "$1" "$@"; export PLM_ENDPOINT="$2"; shift 2 ;;
            -m|--model)       need_arg "$1" "$@"; export PLM_MODEL="$2"; shift 2 ;;
            -p|--parent)      need_arg "$1" "$@"; parent="$2"; shift 2 ;;
            -r|--resend)      resend=1; shift ;;
            --no-stream)      export PLM_USE_STREAM='false'; shift ;;
            --no-auth)        export PLM_API_KEY_REQUIRED=0; shift ;;
            -*|*)             echo "unknown arg: $1" >&2; usage; exit 1 ;;
        esac
    done

    parent="$(sib rev-parse $parent 2>/dev/null || true)"
    parent="${parent:+-p $parent}"

    if [[ -z $resend ]]; then
        [[ -t 0 ]] && echo '(stdin, Ctrl+D to send)' >&2

        plm-wrap -f text -t plm \
            | sib chain-trace-json $parent \
            | xargs sib update-ref HEAD
    fi

    sib rev-jsonl HEAD \
        | plm-wrap -f plm -t request \
        | plm-send \
        | plm-wrap -f response -t plm -r assistant \
        | sib chain-trace-json -p HEAD \
        | xargs sib update-ref HEAD
}

# human-readable message will be streamed to stderr by plm-send.
# User might want to pipe that message.
main "$@" 2>&1
