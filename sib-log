#!/usr/bin/env bash

set -euo pipefail

. lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [-n LINES] [<chain-ish>]
  -n LINES    Truncate content to LINES (disables markdown rendering)
  -h, --help  Show this help
EOF
}

n_lines=
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n)        n_lines="${2:?$1 requires arg}"; shift 2 ;;
        -*)        echo "unknown arg: $1" >&2; usage; exit 1 ;;
        *)         break ;;
    esac
done

target=${1:-HEAD}

show_args=()
[[ -n $n_lines ]] && show_args=(-n "$n_lines")

sib rev-list "$target" | while read -r chain; do
    sib-show "${show_args[@]}" "$chain"
    echo
    echo ---
    echo
done
