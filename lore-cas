#!/usr/bin/env bash
set -euo pipefail

: "${LORE_DIR:?LORE_DIR is not set}"

TRACE_MAGIC=_LORETRACE
TRACE_VERSION=v1

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

lgit() {
    env GIT_AUTHOR_DATE='@0 +0000' \
        GIT_COMMITTER_DATE='@0 +0000' \
        GIT_AUTHOR_NAME='Lore' \
        GIT_COMMITTER_NAME='Lore' \
        GIT_AUTHOR_EMAIL='lore@example.com' \
        GIT_COMMITTER_EMAIL='lore@example.com' \
        git --git-dir="$LORE_DIR" "$@"
}

cmd_init() {
    if [[ -e "$LORE_DIR" ]]; then
        printf 'lore: %s already exists\n' "$LORE_DIR" >&2
        exit 1
    fi
    mkdir -p "$LORE_DIR"
    lgit init --bare --quiet
}

# $1: blob name
hf_blob() {
    [ -n "$1" ] || return 1;
    printf '100644 blob %s\t%s\n' $(lgit hash-object -w --stdin) "$1"
}

# chain-trace [-p <chain>] <trace>
cmd_chain_trace() {
    local parent=
    local trace=

    if [[ $# -eq 1 ]]; then
        trace="$1"
    elif [[ $# -eq 3 && "$1" == "-p" ]]; then
        cmd_ls_trace $2 >/dev/null # check if parent is valid
        parent="-p $2"
        trace="$3"
    else
        die "Usage: chain-trace [-p <chain>] <trace>"
    fi

    cmd_ls_trace $trace >/dev/null # check if itself is valid
    lgit commit-tree $parent $trace </dev/null
}

tf_key() {
    cut -d' ' -f1
}

tf_is_dup() {
    tf_key | sort | uniq -d | grep -q .
}

cmd_mktrace() {
    local lines=$(cat)

    echo "$lines" | tf_is_dup && die 'duplicate key found in input'

    {
        echo -n $TRACE_VERSION | hf_blob $TRACE_MAGIC;
        [ -n "$lines" ] && echo "$lines" | while read key hash; do
                printf "100644 blob %s\t%s\n" "$hash" "$key"
            done
    } | lgit mktree
}

cmd_ls_trace() {
    [ -n "$1" ] || die 'usage: ls-trace <trace>'

    local tmp=$(lgit ls-tree $1 | awk 'NF==4 { print $4, $3 }')

    echo "$tmp" | tf_key | grep -qxF $TRACE_MAGIC || die 'magic not found on trace'
    echo "$tmp" | tf_is_dup && die 'duplicate key found on trace'

    # Here, every key starting with $TRACE_MAGIC will be considered as
    # non-key and internal indicator.
    echo "$tmp" | grep -v "^$TRACE_MAGIC"
}

cmd_git() {
    lgit "$@"
}

main() {
    [[ $# -lt 1 ]] && { echo "usage: lore-cas <cmd> [args]" >&2; exit 1; }
    local cmd="$1"; shift
    local fn="cmd_${cmd//-/_}"
    if declare -F "$fn" > /dev/null; then
        "$fn" "$@"
    else
        printf 'lore-cas: unknown command %q\n' "$cmd" >&2
        exit 1
    fi
}
main "$@"
