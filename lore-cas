#!/usr/bin/env bash
set -euo pipefail

: "${LORE_DIR:?LORE_DIR is not set}"

lgit() {
    git --git-dir="$LORE_DIR" "$@"
}

cmd_init() {
    if [[ -e "$LORE_DIR" ]]; then
        printf 'lore: %s already exists\n' "$LORE_DIR" >&2
        exit 1
    fi
    mkdir -p "$LORE_DIR"
    lgit init --bare --quiet
}

cmd_init_trace() {
    local marker
    marker=$(printf 'LOREv1' | lgit hash-object -w --stdin)
    printf '100644 blob %s\t_LORETRACE\n' "$marker" | lgit mktree
}

# $1: ob, $2: name
format_tree() {
    printf '040000 tree %s\t%s\n' "$1" "$2"
}

cmd_append_key() {
    # TODO: [-r], [-c <offset>:<len>]

    local key="$1"
    local tob="$2"

    local sob=$(lgit hash-object -w --stdin)
    local len=$(lgit cat-file blob $sob | wc -c)

    local kob=$(printf '100644 blob %s\t%012d-O%d-I%d\n' "$sob" 1 0 "$len" \
                    | lgit mktree)

    # FIXME: handle for same key

    {
        lgit ls-tree $tob
        format_tree $kob $key
    } | lgit mktree
}

main() {
    [[ $# -lt 1 ]] && { echo "usage: lore-cas <cmd> [args]" >&2; exit 1; }
    local cmd="$1"; shift
    local fn="cmd_${cmd//-/_}"
    if declare -F "$fn" > /dev/null; then
        "$fn" "$@"
    else
        printf 'lore-cas: unknown command %q\n' "$cmd" >&2
        exit 1
    fi
}
main "$@"
