#!/usr/bin/env bash
set -euo pipefail

: "${LORE_DIR:?LORE_DIR is not set}"

lgit() {
    env GIT_AUTHOR_DATE='@0 +0000' \
        GIT_COMMITTER_DATE='@0 +0000' \
        GIT_AUTHOR_NAME='Lore' \
        GIT_COMMITTER_NAME='Lore' \
        GIT_AUTHOR_EMAIL='lore@example.com' \
        GIT_COMMITTER_EMAIL='lore@example.com' \
        git --git-dir="$LORE_DIR" "$@"
}

cmd_init() {
    if [[ -e "$LORE_DIR" ]]; then
        printf 'lore: %s already exists\n' "$LORE_DIR" >&2
        exit 1
    fi
    mkdir -p "$LORE_DIR"
    lgit init --bare --quiet
}

cmd_init_trace() {
    local marker
    marker=$(printf 'LOREv1' | lgit hash-object -w --stdin)
    printf '100644 blob %s\t_LORETRACE\n' "$marker" | lgit mktree
}

# $1: ob, $2: name
format_tree() {
    printf '040000 tree %s\t%s\n' "$1" "$2"
}

# $1: index
format_key() {
    # TODO: [-c <offset>:<len>]

    local sob=$(lgit hash-object -w --stdin)
    local len=$(lgit cat-file blob $sob | wc -c)

    # FIXME: die if $1 > 10^12
    printf '100644 blob %s\t%012d-O%d-I%d\n' "$sob" $1 0 "$len"
}

# append to existing key object
# $1: kob
append_kob() {
    # TODO: [-c <offset>:<len>]

    # Currently, it is assumed that the kob is an unconditionally
    # perfect key object, but there is no magic to support that
    # assumption. The reason it wasn't included in the design is that
    # the encoding format itself is magic. Anyway, it seems like it
    # would be good to implement something like a checker.
    local index=$(lgit ls-tree $1 | tail -n1 | awk '{ print $4 }' | cut -d'-' -f1)

    {
        lgit ls-tree $1
        format_key $((10#$index + 1)) # overflow?
    } | lgit mktree
}

cmd_append_key() {
    # TODO: [-r], [-c <offset>:<len>]

    local key="$1"
    local tob="$2"

    # FIXME: check here if tob is corrupted (i.e. multiple same key occur)
    local kob=$(lgit ls-tree "$tob" | awk -v k="$key" '$4 == k { print $3 }')

    if [ -n "$kob" ]; then
        kob=$(append_kob "$kob")
        lgit ls-tree "$tob" | awk -v k="$key" -v ob="$kob" '
        BEGIN { FS="\t"; OFS="\t" }
        {
            if ($2 == k) {
                split($1, parts, " ")
                $1 = parts[1] " " parts[2] " " ob
            }
            print $0
        }' | lgit mktree
    else
        kob=$(format_key 1 | lgit mktree)
        {
            lgit ls-tree $tob
            format_tree $kob $key
        } | lgit mktree
    fi
}

# chain-trace [-p <chain>] <trace>
cmd_chain_trace() {
    local parent=
    local trace=

    if [[ $# -eq 1 ]]; then
        trace="$1"
    elif [[ $# -eq 3 && "$1" == "-p" ]]; then
        parent="-p $2"
        trace="$3"
    else
        # TODO: refactor it to use die
        echo "Usage: chain-trace [-p <chain>] <trace>" >&2
        exit 1
    fi

    lgit commit-tree $parent $trace </dev/null
}

main() {
    [[ $# -lt 1 ]] && { echo "usage: lore-cas <cmd> [args]" >&2; exit 1; }
    local cmd="$1"; shift
    local fn="cmd_${cmd//-/_}"
    if declare -F "$fn" > /dev/null; then
        "$fn" "$@"
    else
        printf 'lore-cas: unknown command %q\n' "$cmd" >&2
        exit 1
    fi
}
main "$@"
