#!/usr/bin/env bash
. lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [-k <KEY>] [-n <LINES>] [<chain-ish>]
  -n LINES    Truncate content to LINES
  -k KEY      Only show KEY's value on chain
  -h, --help  Show this help
EOF
}

n_lines= key=
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n)        n_lines="${2:?$1 requires arg}"; shift 2 ;;
        -k)        key="${2:?$1 requires arg}"; shift 2 ;;
        -*)        echo "unknown arg: $1" >&2; usage; exit 1 ;;
        *)         break ;;
    esac
done

render() {
    cat | sed 's/^/    /' && true;
}

truncate_content() {
    [[ -n $n_lines ]] && head -n "$n_lines" || cat
}

target=${1:-HEAD}
chain=$(sib rev-parse $target)

if [[ ! -z $key ]]; then
    sib ls-trace $chain \
        | awk -v k=$key '$1 == k { print $2 }' \
        | xargs sib git cat-file blob
    exit 0
fi

# Normal output
echo "chain $chain"

CONTENT=content

lst="$(sib ls-trace $chain)"
[[ -z $lst ]] && { echo --- Empty trace --- >&2; echo; exit 0; }

# Traverse all key except $CONTENT
echo "$lst" \
    | awk -v k="$CONTENT" '$1 != k { print }' \
    | while IFS=$' ' read -r key value; do

    # Should not die here
    [[ -z $value ]] && die "mallformed ls-tree format $lst"

    value=$(sib git cat-file blob $value)
    echo "${key^}: $value"
done

echo
content=$(echo "$lst" | awk -v k="$CONTENT" '$1 == k { print $2 }')
[[ -z $content ]] && { echo No $CONTENT field on $chain >&2; exit 0; }
sib git cat-file blob $content | truncate_content | render
echo
