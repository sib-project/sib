#!/usr/bin/env bash
source lib.bash

usage() {
    cat <<EOF
usage: ${NAME} [-n LINES] [<chain-ish>]
  -n LINES    Truncate content to LINES (disables markdown rendering)
  -h, --help  Show this help
EOF
}

n_lines=
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n)        n_lines="${2:?$1 requires arg}"; shift 2 ;;
        -*)        echo "unknown arg: $1" >&2; usage; exit 1 ;;
        *)         break ;;
    esac
done

if [[ -z $n_lines ]] && command -v glow >/dev/null; then
    render() { glow -; }
else
    render() { cat | sed 's/^/    /' && true; }
fi

truncate_content() {
    [[ -n $n_lines ]] && head -n "$n_lines" || cat
}

target=${1:-HEAD}
chain=$(sib rev-parse $target)

ls_chain="$(sib ls-chain "$chain")"
parent="$(echo "$ls_chain" | awk '$1=="parent"{print $2}')"
trace="$(echo "$ls_chain" | awk '$1=="trace"{print $2}')"

printkv() {
    printf '%s %s\n' "$1" "$2"
}

# Chain's metadata
printkv 'chain' "$chain"
[[ -n $parent ]] && printkv 'Parent:' "$parent"

CONTENT=content

# Traverse all key except $CONTENT
sib ls-trace $trace | awk -v k="$CONTENT" '$1 != k { print }' \
    | while IFS=$' ' read -r key value; do

    # Capitalize first letter
    key=$(printf '%s' "${key^}:")
    value=$(sib git cat-file blob $value)
    printkv "$key" "$value"
done

printf '\n'
sib ls-trace $trace | awk -v k="$CONTENT" '$1 == k { print $2 }' \
    | xargs sib git cat-file blob \
    | truncate_content | render
printf '\n'
